{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "/absolute/path/to/agent-completion-sounds/scripts/play-random-completion-sound.sh"
      }
    ],
    "stop": [
      {
        "command": "/absolute/path/to/agent-completion-sounds/scripts/play-random-completion-sound.sh"
      }
    ]
  }
}
