{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/absolute/path/to/agent-completion-sounds/scripts/play-random-completion-sound.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/absolute/path/to/agent-completion-sounds/scripts/play-random-completion-sound.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
